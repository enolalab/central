{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "central/plan-change-v1.schema.json",
  "title": "PlanRevisionProposalV1",
  "description": "Immutable revision proposal: the base plan hash, the full replacement plan document, the reason, the criteria explanation (required when verification criteria move) and the leader-supplied semantic nodes, which can only expand the computed impact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "basePlan", "plan", "reason", "semanticAffected"],
  "properties": {
    "version": { "const": 1 },
    "basePlan": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Hex SHA-256 of the approved plan document this revision diffs against."
    },
    "plan": { "$ref": "#/$defs/planDocument" },
    "reason": {
      "type": "string",
      "minLength": 1,
      "description": "Why the revision exists, for the user review."
    },
    "criteriaExplanation": {
      "type": ["string", "null"],
      "description": "Requirement/verdict impact plus reverify tasks. Mandatory when verification criteria move; null otherwise."
    },
    "semanticAffected": {
      "type": "array",
      "items": { "$ref": "#/$defs/uuid" },
      "description": "Leader-supplied semantic nodes. They expand the machine impact and never shrink it."
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "verifySpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "criteria"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "planTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "objective",
        "inputs",
        "scope",
        "outOfScope",
        "dependsOn",
        "dataDependsOn",
        "outputs",
        "verify",
        "evidence",
        "profileId",
        "permissions",
        "maxRepairRounds",
        "requiresApproval",
        "handover"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "kind": {
          "type": "string",
          "enum": ["planning", "implementation", "verification", "integration", "assessment", "proposal", "approval"]
        },
        "objective": { "type": "string", "minLength": 1 },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "scope": { "type": "array", "items": { "type": "string" } },
        "outOfScope": { "type": "array", "items": { "type": "string" } },
        "dependsOn": { "type": "array", "items": { "$ref": "#/$defs/uuid" } },
        "dataDependsOn": { "type": "array", "items": { "$ref": "#/$defs/uuid" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "verify": { "anyOf": [{ "$ref": "#/$defs/verifySpec" }, { "type": "null" }] },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "profileId": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "maxRepairRounds": { "type": "integer", "minimum": 0, "maximum": 2 },
        "requiresApproval": { "type": "array", "items": { "type": "string" } },
        "handover": { "type": "string" }
      }
    },
    "planDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "goal", "tasks"],
      "properties": {
        "version": { "const": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/planTask" }
        }
      }
    }
  }
}
